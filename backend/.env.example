# URI de conexión a MongoDB. Reemplazar por la URI local o de Atlas del entorno.
MONGODB_URI="mongodb://127.0.0.1:27017/olla_vegana"

# Puerto local donde escucha el servidor.
PORT=3001

# Nivel mínimo de logs estructurados enviados a stdout/stderr: INFO, WARN o ERROR.
LOG_LEVEL=INFO

# Retención objetivo en días; debe configurarse también en la plataforma de logs.
LOG_RETENTION_DAYS=30

# Alertas externas apagadas por defecto y sin proveedor configurado.
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=""
ALERT_COOLDOWN_SECONDS=300

# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Origen(es) permitido(s) para las solicitudes CORS del frontend.
# En producción, separar varios orígenes con comas (sin barra final).
FRONTEND_URL="https://ollavegana.org,https://www.ollavegana.org"

# Secreto de al menos 32 caracteres para firmar y verificar tokens JWT.
JWT_SECRET="ejemplo_falso_no_usar_en_produccion_123456"

# Token privado de acceso a la API de Mercado Pago.
MP_ACCESS_TOKEN="TEST-token-falso"

# Secreto usado para verificar firmas de webhooks de Mercado Pago.
MP_WEBHOOK_SECRET="secreto-webhook-falso"

# Clave pública de Mercado Pago para el frontend.
MP_PUBLIC_KEY="TEST-clave-publica-falsa"

# Entorno permitido para la integración inicial. Mantener en test durante desarrollo.
MP_ENVIRONMENT=test

# Habilita internamente crear Orders API; requiere pruebas aisladas y revisión previa.
MP_ORDER_CREATION_ENABLED=false

# Confirmación explícita de que pedidos y reservas CAR-05/CAR-06 pasaron QA aislado.
MP_ORDER_FLOW_READY=false

# Confirmación explícita de que la verificación de pagos por webhook ya está lista.
MP_WEBHOOKS_READY=false

# ID de aplicación de Mercado Pago para validar que la order pertenece a esta integración.
MP_APPLICATION_ID=""

# ID numérico de la cuenta vendedora esperado en el webhook y la order consultada.
MP_USER_ID=""

# Habilita los efectos de webhooks solo en entorno de prueba y tras verificar todos los requisitos.
MP_WEBHOOK_EFFECTS_ENABLED=false

# Habilita solicitudes de reintegro a Orders API solo tras aprobación operativa y testing aislado.
MP_REFUND_OPERATIONS_ENABLED=false

# Habilita cancelar Orders API no pagadas solo tras aprobación operativa y testing aislado.
MP_ORDER_CANCELLATION_ENABLED=false

# URL pública HTTPS del frontend para los retornos de Checkout Pro (ejemplo reservado).
FRONTEND_PUBLIC_URL="https://example.test"

# Servidor SMTP para el envío de correo.
SMTP_HOST="smtp.example.test"

# Puerto del servidor SMTP.
SMTP_PORT=587

# Usuario de autenticación SMTP.
SMTP_USER="usuario-smtp-falso"

# Contraseña de autenticación SMTP.
SMTP_PASS="clave-smtp-falsa"

# Dirección que aparecerá como remitente de los correos.
MAIL_FROM="Olla Vegana <noreply@example.test>"

# El envío transaccional real permanece apagado hasta completar QA integral.
EMAIL_SENDING_ENABLED=false

# Nombre de la cuenta de Cloudinary para almacenar fotografías.
CLOUDINARY_CLOUD_NAME=""

# Clave pública de API de Cloudinary.
CLOUDINARY_API_KEY=""

# Secreto de API de Cloudinary; mantenerlo solo en el entorno del servidor.
CLOUDINARY_API_SECRET=""

# Tamaño máximo en bytes por imagen; valor de ejemplo: 5 MiB.
IMAGE_MAX_SIZE_BYTES=5242880

# Umbral inclusivo para alertas de stock bajo del resumen administrativo.
ADMIN_LOW_STOCK_THRESHOLD=5

# Habilita cambios de estado operativo solo después de validar transacciones en MongoDB aislado.
ADMIN_ORDER_STATUS_CHANGES_ENABLED=false

# Habilita confirmar transferencias solo después de validar PAG-03 en MongoDB aislado.
ADMIN_TRANSFER_CONFIRMATION_ENABLED=false
