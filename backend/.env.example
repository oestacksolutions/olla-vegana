# URI de conexión a MongoDB. Reemplazar por la URI local o de Atlas del entorno.
MONGODB_URI="mongodb://127.0.0.1:27017/olla_vegana"

# Puerto local donde escucha el servidor.
PORT=3001

# Entorno de ejecución: development, test o production.
NODE_ENV=development

# Origen permitido para las solicitudes CORS del frontend.
FRONTEND_URL="http://localhost:5173"

# Secreto de al menos 32 caracteres para firmar y verificar tokens JWT.
JWT_SECRET="ejemplo_falso_no_usar_en_produccion_123456"

# Token privado de acceso a la API de Mercado Pago.
MP_ACCESS_TOKEN="TEST-token-falso"

# Secreto usado para verificar firmas de webhooks de Mercado Pago.
MP_WEBHOOK_SECRET="secreto-webhook-falso"

# Clave pública de Mercado Pago para el frontend.
MP_PUBLIC_KEY="TEST-clave-publica-falsa"

# Servidor SMTP para el envío de correo.
SMTP_HOST="smtp.example.test"

# Puerto del servidor SMTP.
SMTP_PORT=587

# Usuario de autenticación SMTP.
SMTP_USER="usuario-smtp-falso"

# Contraseña de autenticación SMTP.
SMTP_PASS="clave-smtp-falsa"

# Dirección que aparecerá como remitente de los correos.
MAIL_FROM="Olla Vegana <noreply@example.test>"
