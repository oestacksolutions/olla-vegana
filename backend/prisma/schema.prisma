generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  correo             String                  @unique
  contrasena         String
  activo             Boolean                 @default(true)
  historialesEstados HistorialEstadoPedido[]
}

model Categoria {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  nombre      String
  slug        String      @unique
  descripcion String?
  activa      Boolean     @default(true)
  padreId     String?     @db.ObjectId
  padre       Categoria?  @relation("Subcategorias", fields: [padreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hijas       Categoria[] @relation("Subcategorias")
  productos   Producto[]

  @@index([padreId])
}

model Producto {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  nombre        String
  slug          String           @unique
  descripcion   String
  precioBase    Float
  activo        Boolean          @default(true)
  destacado     Boolean          @default(false)
  categoriaId   String           @db.ObjectId
  categoria     Categoria        @relation(fields: [categoriaId], references: [id])
  variantes     Variante[]
  imagenes      ImagenProducto[]
  itemsPedido   ItemPedido[]
  creadoEn      DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([categoriaId])
}

model Variante {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  productoId  String            @db.ObjectId
  producto    Producto          @relation(fields: [productoId], references: [id], onDelete: Restrict)
  precio      Float?
  stock       Int               @default(0)
  activa      Boolean           @default(true)
  valores     ValorVariante[]
  imagenes    ImagenProducto[]
  movimientos MovimientoStock[]
  itemsPedido ItemPedido[]
  reservas    ReservaStock[]

  @@index([productoId])
}

model ImagenProducto {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  url        String
  posicion   Int       @default(0)
  productoId String    @db.ObjectId
  producto   Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteId String?   @db.ObjectId
  variante   Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)

  @@index([productoId])
  @@index([varianteId])
}

model Atributo {
  id      String          @id @default(auto()) @map("_id") @db.ObjectId
  nombre  String          @unique
  valores ValorAtributo[]
}

model ValorAtributo {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  valor      String
  atributoId String          @db.ObjectId
  atributo   Atributo        @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  variantes  ValorVariante[]

  @@unique([atributoId, valor])
}

model ValorVariante {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  varianteId      String        @db.ObjectId
  variante        Variante      @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  valorAtributoId String        @db.ObjectId
  valorAtributo   ValorAtributo @relation(fields: [valorAtributoId], references: [id])

  @@unique([varianteId, valorAtributoId])
  @@index([valorAtributoId])
}

model MovimientoStock {
  id         String              @id @default(auto()) @map("_id") @db.ObjectId
  varianteId String              @db.ObjectId
  variante   Variante            @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  tipo       TipoMovimientoStock
  cantidad   Int
  motivo     String?
  creadoEn   DateTime            @default(now())

  @@index([varianteId])
}

model PuntoRetiro {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String   @unique
  direccion String
  horarios  String
  activo    Boolean  @default(true)
  pedidos   Pedido[]
}

model Pedido {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  numero           Int                     @unique
  nombre           String
  apellido         String
  correo           String
  telefono         String?
  metodoPago       MetodoPago
  estadoPago       EstadoPago              @default(PENDIENTE)
  estado           EstadoPedido            @default(NUEVO)
  total            Float
  puntoRetiroId    String                  @db.ObjectId
  puntoRetiro      PuntoRetiro             @relation(fields: [puntoRetiroId], references: [id])
  mpPreferenciaId  String?
  mpPagoId         String?
  notaPago         String?
  pagoVerificadoEn DateTime?
  pagadoEn         DateTime?
  retiradoEn       DateTime?
  venceEn          DateTime?
  items            ItemPedido[]
  reservas         ReservaStock[]
  historialEstados HistorialEstadoPedido[]
  eventosPago      EventoPago[]
  creadoEn         DateTime                @default(now())

  @@index([correo])
  @@index([estado])
  @@index([estadoPago])
  @@index([creadoEn])
}

model ReservaStock {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  pedidoId     String        @db.ObjectId
  pedido       Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  varianteId   String        @db.ObjectId
  variante     Variante      @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  cantidad     Int
  estado       EstadoReserva @default(ACTIVA)
  creadoEn     DateTime      @default(now())
  venceEn      DateTime
  confirmadaEn DateTime?
  liberadaEn   DateTime?

  @@unique([pedidoId, varianteId])
  @@index([estado, venceEn])
  @@index([varianteId])
}

model ItemPedido {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  pedidoId        String    @db.ObjectId
  pedido          Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  productoId      String    @db.ObjectId
  producto        Producto  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  varianteId      String?   @db.ObjectId
  variante        Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  nombreProducto  String
  detalleVariante String?
  cantidad        Int
  precio          Float

  @@index([pedidoId])
}

model HistorialEstadoPedido {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  pedidoId       String        @db.ObjectId
  pedido         Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  estadoAnterior EstadoPedido?
  estadoNuevo    EstadoPedido
  nota           String?
  adminId        String?       @db.ObjectId
  admin          Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  creadoEn       DateTime      @default(now())

  @@index([pedidoId])
}

model EventoPago {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  proveedor   String
  idExterno   String
  tipo        String
  contenido   Json
  pedidoId    String?   @db.ObjectId
  pedido      Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  procesadoEn DateTime?
  creadoEn    DateTime  @default(now())

  @@index([idExterno])
  @@index([pedidoId])
}

model Banner {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  imagenUrl      String
  dispositivo    DispositivoBanner
  posicion       Int               @default(0)
  posicionImagen String            @default("center")
  terminaEn      DateTime?
  activo         Boolean           @default(true)
}

model Configuracion {
  clave         String   @id @map("_id")
  valor         String
  updatedAt     DateTime @updatedAt
}

enum MetodoPago {
  MERCADO_PAGO
  TRANSFERENCIA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

enum EstadoPedido {
  NUEVO
  EN_PREPARACION
  LISTO_PARA_RETIRAR
  RETIRADO
  CANCELADO
}

enum EstadoReserva {
  ACTIVA
  CONFIRMADA
  LIBERADA
}

enum TipoMovimientoStock {
  INGRESO
  AJUSTE
  VENTA
  DEVOLUCION
}

enum DispositivoBanner {
  ESCRITORIO
  CELULAR
}
